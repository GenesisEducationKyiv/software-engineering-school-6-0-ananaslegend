{
  "uid": "reposeetory-red",
  "title": "Reposeetory RED",
  "tags": ["observability", "red"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "timezone": "",
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": { "qryType": 1, "query": "label_values(http_requests_total, instance)" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      },
      {
        "name": "path",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "victoriametrics" },
        "query": { "qryType": 1, "query": "label_values(http_requests_total{instance=~\"$instance\"}, path)" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "selected": false, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate by path",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(path) (rate(http_requests_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP error ratio (5xx)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{instance=~\"$instance\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{instance=~\"$instance\"}[5m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP p95 latency by path",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le,path) (rate(http_request_duration_seconds_bucket{instance=~\"$instance\",path=~\"$path\"}[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GitHub client rate by result",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(result) (rate(github_client_requests_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GitHub client p95 latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(github_client_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Email rate by driver/result",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(driver, result) (rate(email_requests_total[5m]))",
          "legendFormat": "{{driver}}/{{result}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Email p95 latency by driver",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le, driver) (rate(email_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{driver}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Scanner tick rate by result",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(result) (rate(scanner_requests_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Notifier tick rate by result",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(result) (rate(notifier_requests_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Confirmer tick rate by result",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(result) (rate(confirmer_requests_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "Outbox depth (release)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "release_notifications_pending"
        }
      ]
    },
    {
      "id": 12,
      "type": "gauge",
      "title": "Outbox depth (confirmation)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "confirmation_notifications_pending"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Goroutines",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "DB pool acquired connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "db_pool_acquired_conns",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Log shipper sent rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(logshipper_sent_total[5m])",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Log shipper dropped rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "datasource": { "type": "prometheus", "uid": "victoriametrics" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(logshipper_dropped_total[5m])",
          "legendFormat": "{{reason}}"
        }
      ]
    }
  ]
}
