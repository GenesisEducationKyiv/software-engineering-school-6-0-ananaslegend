# HTTP server
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

# PostgreSQL
DATABASE_URL=postgres://postgres:pass@localhost:5432/postgres?sslmode=disable
DB_MAX_CONNS=10

# Redis (optional — leave empty to disable GitHub release caching)
# REDIS_URL=redis://localhost:6379

# Application
APP_BASE_URL=http://localhost:8080
CONFIRM_TOKEN_TTL=24h

# Notifications service (cmd/notifications-svc) — the monolith POSTs notification requests here
NOTIFICATIONS_URL=http://localhost:8081
NOTIFICATIONS_HTTP_ADDR=:8081

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# SMTP / Resend below are consumed by the notifications service (cmd/notifications-svc), not the monolith.
# SMTP (leave SMTP_HOST empty to use StubMailer / console logging)
# Dev: brew install mailpit && mailpit  →  web UI at http://localhost:8025, SMTP at localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS_POLICY=none
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Resend (alternative to SMTP — works on Railway; set RESEND_API_KEY to activate)
# RESEND_API_KEY=re_...
# RESEND_FROM=noreply@yourdomain.com

# Docker overrides (values below match docker-compose.yml defaults — uncomment to override)
# DATABASE_URL=postgres://postgres:pass@postgres:5432/postgres?sslmode=disable
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_TLS_POLICY=none

# GitHub (required for scanner — GraphQL API returns 403 without token; scanner is disabled if empty)
# GITHUB_TOKEN=

# Scanner / Notifier / Confirmer
SCANNER_INTERVAL=5m
NOTIFIER_INTERVAL=30s
CONFIRMER_INTERVAL=30s
